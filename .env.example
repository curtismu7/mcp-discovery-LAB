# Copy to .env (never commit it). Real environment variables win over this file.
# Ports 5300-5999 only. The server uses 5310; the in-process demo stubs use 5311-5319.
MCP_DISCOVERY_PORT=5310
# The server binds 127.0.0.1 only. Setting MCP_DISCOVERY_BIND to another address (0.0.0.0 inside a container) is the
# explicit opt-in to listen off-box, and is refused together with MCP_DISCOVERY_LIVE=1.
# MCP_DISCOVERY_BIND=127.0.0.1

# DEMO MODE is the default: fixtures and in-process stub MCP servers, the real host is never read.
# Opt in to scanning THIS machine (ps, lsof, docker ps, listed client config files; read-only, loopback and stdio only):
# MCP_DISCOVERY_LIVE=1
# Live mode only. Comma-separated.
# MCP_DISCOVERY_CONFIG_PATHS=/absolute/path/to/a/client-config.json
# MCP_DISCOVERY_REMOTE_URLS=https://mcp.example.com/mcp   (listed in the inventory, never contacted)
# MCP_DISCOVERY_STORE_PATH=.data/inventory.json            (live mode only; demo mode keeps everything in memory)
